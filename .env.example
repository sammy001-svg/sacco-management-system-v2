# =====================================================================
#  SaccoPro configuration
#  Copy this file to ".env" and fill in your values.
#  The web installer (install.php) can also write it for you.
#  Never commit or share .env — it contains your database password.
# =====================================================================

# --- Application -------------------------------------------------------
APP_NAME=SaccoPro
# production | staging | local
APP_ENV=production
# true shows PHP errors in the browser. Keep false on a live server.
APP_DEBUG=false
# Public address, e.g. https://sacco.example.com or https://example.com/sacco
APP_URL=https://sacco.example.com
APP_TIMEZONE=Africa/Nairobi
# Redirect every http:// request to https:// (enable once SSL is active
# in cPanel → SSL/TLS Status or AutoSSL).
FORCE_HTTPS=true

# --- Database (cPanel → MySQL® Databases) -----------------------------
# On cPanel the database and user names carry your account prefix,
# e.g. cpuser_sacco and cpuser_saccoadmin.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_sacco
DB_USERNAME=cpuser_saccoadmin
DB_PASSWORD="change-me"
# Leave as is unless your host requires something else.
DB_SQL_MODE=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# --- Sessions & sign-in security ---------------------------------------
SESSION_NAME=saccopro_sid
# Minutes of inactivity before staff are signed out
SESSION_IDLE_MINUTES=120
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- M-Pesa: Lipa na M-Pesa Online / STK push (Safaricom Daraja) ----------
# Create an app at https://developer.safaricom.co.ke and copy its keys.
# sandbox = Daraja test environment, live = real money.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# paybill: MPESA_SHORTCODE is your Paybill number.
# till:    MPESA_SHORTCODE is the store (head office) number and
#          MPESA_TILL_NUMBER is the Till that receives the money.
MPESA_TYPE=paybill
MPESA_SHORTCODE=174379
MPESA_TILL_NUMBER=
# Lipa na M-Pesa Online passkey (Safaricom emails it when STK push is enabled).
MPESA_PASSKEY=
# Long random secret that protects the callback address. Leave blank on a
# fresh install and the installer/migration fills one in for you.
MPESA_CALLBACK_KEY=change-me-to-a-long-random-string
# Optional. Defaults to APP_URL/mpesa_callback.php?key=MPESA_CALLBACK_KEY
# (must be public HTTPS for Safaricom to reach it).
MPESA_CALLBACK_URL=
# Optional comma-separated list of IPs allowed to call the callback.
MPESA_ALLOWED_IPS=

# --- SMS: Shanfix SMS (sms.shanfixtechnology.com → Client → API) ----------
SMS_BASE_URL=https://sms.shanfixtechnology.com
SMS_CLIENT_ID=
SMS_API_KEY=
# Approved sender ID on your Shanfix account (blank = your first approved one).
SMS_SENDER_ID=

# --- Installer -----------------------------------------------------------
# Set to false after installation: install.php then refuses to run.
INSTALLER_ENABLED=true
