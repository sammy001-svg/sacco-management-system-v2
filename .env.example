# =====================================================================
#  SaccoPro configuration
#  Copy this file to ".env" and fill in your values.
#  The web installer (install.php) can also write it for you.
#  Never commit or share .env — it contains your database password.
# =====================================================================

# --- Application -------------------------------------------------------
APP_NAME=SaccoPro
# production | staging | local
APP_ENV=production
# true shows PHP errors in the browser. Keep false on a live server.
APP_DEBUG=false
# Public address, e.g. https://sacco.example.com or https://example.com/sacco
APP_URL=https://sacco.example.com
APP_TIMEZONE=Africa/Nairobi
# Redirect every http:// request to https:// (enable once SSL is active
# in cPanel → SSL/TLS Status or AutoSSL).
FORCE_HTTPS=true

# --- Database (cPanel → MySQL® Databases) -----------------------------
# On cPanel the database and user names carry your account prefix,
# e.g. cpuser_sacco and cpuser_saccoadmin.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_sacco
DB_USERNAME=cpuser_saccoadmin
DB_PASSWORD="change-me"
# Leave as is unless your host requires something else.
DB_SQL_MODE=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# --- Sessions & sign-in security ---------------------------------------
SESSION_NAME=saccopro_sid
# Minutes of inactivity before staff are signed out
SESSION_IDLE_MINUTES=120
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Installer -----------------------------------------------------------
# Set to false after installation: install.php then refuses to run.
INSTALLER_ENABLED=true
